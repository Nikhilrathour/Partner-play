<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_rounded_bg"
    android:padding="8dp">

    <!-- Discreet Header Pill -->
    <TextView
        android:id="@+id/widget_room_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:background="@drawable/widget_pill_bg"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="❤️ Partner Play"
        android:textColor="#FF5722"
        android:textSize="11sp" />

    <!-- Full Frame Partner Drawing Canvas -->
    <ImageView
        android:id="@+id/widget_canvas_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_room_code"
        android:layout_marginTop="4dp"
        android:adjustViewBounds="true"
        android:contentDescription="Partner Drawing Canvas"
        android:scaleType="fitCenter" />

    <!-- Elegant Watermark when Empty -->
    <TextView
        android:id="@+id/widget_empty_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="Tap to draw ✨"
        android:textColor="#C4BFB6"
        android:textSize="12sp"
        android:visibility="gone" />

</RelativeLayout>
