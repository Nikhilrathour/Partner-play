<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_rounded_bg"
    android:padding="10dp">

    <!-- Top Status Bar in Widget -->
    <RelativeLayout
        android:id="@+id/widget_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/widget_room_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_pill_bg"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="❤️ Partner Play"
            android:textColor="#FF5722"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Live Sync"
            android:textColor="#8E8B85"
            android:textSize="10sp" />
    </RelativeLayout>

    <!-- Bottom Action Bar in Widget -->
    <RelativeLayout
        android:id="@+id/widget_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">

        <TextView
            android:id="@+id/widget_author_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Tap to open &amp; draw"
            android:textColor="#A1A1AA"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_refresh_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Auto-sync"
            android:textColor="#FF5722"
            android:textSize="9sp" />
    </RelativeLayout>

    <!-- Main Canvas Drawing Image -->
    <ImageView
        android:id="@+id/widget_canvas_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/widget_bottom_bar"
        android:layout_below="@id/widget_top_bar"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:adjustViewBounds="true"
        android:contentDescription="Partner Drawing Canvas"
        android:scaleType="fitCenter" />

</RelativeLayout>
